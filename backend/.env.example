# Neo4j (docker compose up -d из корня проекта)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=shorthack_graphiti

# LLM для Graphiti (эмбеддинги + экстракция сущностей)
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1  # для совместимых провайдеров

# Yandex GPT (классификация обращений + генерация ответов)
# Пока YANDEX_API_KEY пустой или равен "placeholder", работает fallback-режим
# (локальные правила/шаблоны) — приложение запускается и без ключа.
YANDEX_API_KEY=placeholder
YANDEX_FOLDER_ID=placeholder
YANDEX_MODEL_CLASSIFY=yandexgpt-lite
YANDEX_MODEL_GENERATE=yandexgpt-lite

# Telegram-бот
# Токен бота: получить у @BotFather; без него бот не стартует (core API работает).
TG_BOT_TOKEN=
# ID дежурного чата для исходящих сообщений без привязанного chat_id
# (число; у групп — отрицательное, например -1001234567890).
TG_DUTY_CHAT_ID=

# Внутренний токен для авторизации Telegram-бота -> Core API (заголовок X-Bot-Token)
# Сгенерировать: openssl rand -hex 24. Пустое значение = хуки /api/internal/* отключены (401).
BOT_INTERNAL_TOKEN=placeholder

# URL Core API, к которому обращается бот
CORE_API_URL=http://localhost:8000
